# ============================================
#  FarmPlus Docker Environment Configuration
# ============================================
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ============================================

# ── Port Configuration ──────────────────────
FRONTEND_PORT=3000
EXPRESS_PORT=5000
FASTAPI_PORT=8000
MONGO_PORT=27017

# ── FastAPI ──────────────────────────────────
FASTAPI_ENV=production

# ── JWT Authentication ───────────────────────
JWT_SECRET=change_me_to_a_strong_random_secret

# ── Twilio SMS Verification (optional) ──────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=
