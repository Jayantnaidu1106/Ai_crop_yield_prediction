# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/agrivision_ai
# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/agrivision_ai?retryWrites=true&w=majority

# Twilio Credentials
# Get these from your Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Service SID from Twilio Verify -> Services
# Create a new Verify Service in Twilio Console if you don't have one
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid_here

# JWT Configuration
# Generate a strong random string for production (at least 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random_at_least_32_characters
JWT_EXPIRES_IN=7d

# API Configuration
API_BASE_URL=http://localhost:3000

# ML Service Configuration
ML_API_URL=http://localhost:8000

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Email Configuration (optional, for future features)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# External API Keys (optional, for weather/market data)
# WEATHER_API_KEY=your_weather_api_key
# MARKET_API_KEY=your_market_api_key

# File Upload Configuration (optional)
# MAX_FILE_SIZE=5mb
# UPLOAD_PATH=./uploads

# Redis Configuration (optional, for caching)
# REDIS_URL=redis://localhost:6379

# Logging Configuration
# LOG_LEVEL=info
# LOG_FILE=./logs/app.log

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit the .env file to version control
# 4. Make sure MongoDB is running locally or use MongoDB Atlas
# 5. Install mongoose: npm install mongoose
