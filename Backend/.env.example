# Twilio Credentials
# Get these from your Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Service SID from Twilio Verify -> Services
# Create a new Verify Service in Twilio Console if you don't have one
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid_here

# JWT Secret (Used for logging the user in after successful verification)
# Generate a strong random string for production
JWT_SECRET=your_jwt_secret_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual Twilio credentials
# 3. Never commit the .env file to version control
